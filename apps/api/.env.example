DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/gestion_locative
NODE_ENV=development
PORT=3001
STORAGE_PATH=./storage
# Secret de signature des sessions (32 caractères minimum, obligatoire en production) : openssl rand -hex 32
SESSION_SECRET=
# true quand l'application est servie en HTTPS (cookie de session « Secure »)
COOKIE_SECURE=false
# Adresse de l'application, pour les liens des e-mails et notifications (ex. https://gestion.exemple.fr)
APP_URL=
# Envoi des e-mails (notifications). Sans SMTP_HOST, aucun e-mail n'est envoyé.
# Gmail : smtp.gmail.com, port 465, SMTP_USER = l'adresse, SMTP_PASS = un « mot de passe d'application »
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
