generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// UTILISATEURS
// ─────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  firstName          String
  lastName           String
  role               Role     @default(USER)
  // Adresse du bailleur, imprimée sur les quittances
  address            String?
  zipCode            String?
  city               String?
  // Image de la signature (PNG ou JPEG), apposée sur les quittances ; chemin relatif à STORAGE_PATH
  signaturePath      String?
  // Compte créé par un administrateur avec un mot de passe provisoire
  mustChangePassword Boolean  @default(false)
  // Incrémentée au changement de mot de passe : invalide les sessions ouvertes ailleurs
  sessionVersion     Int      @default(0)
  // Notifications : délai avant l'anniversaire des baux, e-mail, téléphone (ntfy ou SMS Free Mobile)
  notifyDaysBefore   Int      @default(60)
  notifyEmail        Boolean  @default(true)
  ntfyTopic          String?
  freeMobileUser     String?
  freeMobileKey      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ownerships     Ownership[]
  createdTenants Tenant[]       @relation("TenantCreatedBy")
  notifications  Notification[]
}

// ─────────────────────────────────────────
// BIENS IMMOBILIERS
// ─────────────────────────────────────────

enum PropertyType {
  APARTMENT
  HOUSE
  PARKING
  COMMERCIAL
}

enum FiscalRegime {
  NU
  PINEL
  LMNP_MICRO
  LMNP_REEL
}

model Property {
  id           String       @id @default(cuid())
  name         String
  address      String
  zipCode      String
  city         String
  type         PropertyType
  surface      Float
  fiscalRegime FiscalRegime
  irlQuarter   Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  ownerships  Ownership[]
  leases      Lease[]
  charges     Charge[]
  lmnpEntries LmnpEntry[]
  documents   Document[]
}

model Ownership {
  id         String    @id @default(cuid())
  property   Property  @relation(fields: [propertyId], references: [id])
  propertyId String
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  share      Float     @default(1.0)
  // Période de détention (bornes incluses) ; null = depuis toujours / encore propriétaire
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())

  @@unique([propertyId, userId])
}

// ─────────────────────────────────────────
// LOCATAIRES
// ─────────────────────────────────────────

model Tenant {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  iban        String?
  // Propriétaire qui a saisi le locataire : il le voit même sans bail (sinon, visibilité par les baux)
  createdBy   User?    @relation("TenantCreatedBy", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leases    Lease[]
  documents Document[]
}

// ─────────────────────────────────────────
// BAUX
// ─────────────────────────────────────────

enum LeaseType {
  UNFURNISHED
  FURNISHED
}

model Lease {
  id             String    @id @default(cuid())
  property       Property  @relation(fields: [propertyId], references: [id])
  propertyId     String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  tenantId       String
  type           LeaseType
  startDate      DateTime
  endDate        DateTime?
  rentAmount     Float
  chargesAmount  Float
  rentDayOfMonth Int       @default(1)
  irlReference   Float?
  irlQuarter     Int?
  irlYear        Int?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  rentPayments          RentPayment[]
  chargeRegularizations ChargeRegularization[]
  rentRevisions         RentRevision[]
  documents             Document[]
  inventories           Inventory[]
}

// ─────────────────────────────────────────
// PAIEMENTS & QUITTANCES
// ─────────────────────────────────────────

enum PaymentStatus {
  PENDING
  RECEIVED
  PARTIAL
  LATE
}

enum PaymentSource {
  MANUAL
  BANK_MATCH
}

model RentPayment {
  id                String           @id @default(cuid())
  lease             Lease            @relation(fields: [leaseId], references: [id])
  leaseId           String
  periodMonth       Int
  periodYear        Int
  // Période couverte (prorata si le bail commence ou finit dans le mois)
  periodStart       DateTime
  periodEnd         DateTime
  // Montants attendus figés à la génération (loyer et charges, proratisés)
  rentAmount        Float
  chargesAmount     Float
  expectedAmount    Float
  receivedAmount    Float?
  paymentDate       DateTime?
  status            PaymentStatus    @default(PENDING)
  source            PaymentSource    @default(MANUAL)
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  bankTransactionId String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  receipt Receipt?

  @@unique([leaseId, periodYear, periodMonth])
}

model Receipt {
  id            String      @id @default(cuid())
  rentPayment   RentPayment @relation(fields: [rentPaymentId], references: [id])
  rentPaymentId String      @unique
  filePath      String
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
}

// ─────────────────────────────────────────
// TRANSACTIONS BANCAIRES (Phase 3)
// ─────────────────────────────────────────

enum TransactionStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

model BankTransaction {
  id         String            @id @default(cuid())
  externalId String            @unique
  amount     Float
  label      String
  date       DateTime
  status     TransactionStatus @default(UNMATCHED)
  createdAt  DateTime          @default(now())

  rentPayment RentPayment?
}

// ─────────────────────────────────────────
// CHARGES (Phase 4)
// ─────────────────────────────────────────

model Charge {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  year       Int
  // Trimestre (1 à 4) ou null pour l'année entière
  quarter    Int?
  label      String
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Régularisation annuelle des charges d'un bail : charges réelles du bien au prorata de l'occupation,
// moins les provisions appelées sur l'année (balance > 0 : à réclamer au locataire, < 0 : à lui rembourser)
model ChargeRegularization {
  id           String    @id @default(cuid())
  lease        Lease     @relation(fields: [leaseId], references: [id])
  leaseId      String
  year         Int
  occupiedDays Int
  daysInYear   Int
  totalCharged Float
  totalReal    Float
  balance      Float
  filePath     String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@unique([leaseId, year])
}

// Révision annuelle du loyer selon l'IRL (art. 17-1 de la loi du 6 juillet 1989).
// Les valeurs « previous* » permettent d'annuler la dernière révision et de calculer le loyer d'une période passée.
model RentRevision {
  id                 String   @id @default(cuid())
  lease              Lease    @relation(fields: [leaseId], references: [id])
  leaseId            String
  effectiveDate      DateTime
  previousRent       Float
  newRent            Float
  previousIrlValue   Float
  previousIrlQuarter Int
  previousIrlYear    Int
  newIrlValue        Float
  newIrlYear         Int
  createdAt          DateTime @default(now())

  @@index([leaseId, effectiveDate])
}

// ─────────────────────────────────────────
// INDICES IRL (Phase 4)
// ─────────────────────────────────────────

model IrlIndex {
  id          String    @id @default(cuid())
  quarter     Int
  year        Int
  value       Float
  // INSEE (import automatique depuis la BDM) ou MANUAL (saisi à la main)
  source      String    @default("MANUAL")
  // Date de publication au Journal officiel (import INSEE)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([quarter, year])
}

// ─────────────────────────────────────────
// COMPTABILITÉ LMNP (Phase 5)
// ─────────────────────────────────────────

enum LmnpEntryType {
  DEPRECIATION
  LOAN_INTEREST
  INSURANCE
  MANAGEMENT_FEES
  LAND_TAX
  MAINTENANCE
  OTHER
}

model LmnpEntry {
  id         String        @id @default(cuid())
  property   Property      @relation(fields: [propertyId], references: [id])
  propertyId String
  year       Int
  type       LmnpEntryType
  label      String
  amount     Float
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

// ─────────────────────────────────────────
// DOCUMENTS (US-04)
// ─────────────────────────────────────────

// Type de document (catégories de la maquette, plus celles d'un bien)
enum DocumentCategory {
  LEASE_CONTRACT // contrat de bail
  INVENTORY_ENTRY // état des lieux d'entrée
  INVENTORY_EXIT // état des lieux de sortie
  INSURANCE // attestation d'assurance
  PHOTO
  DIAGNOSTIC // diagnostics (DPE, électricité, plomb…)
  TITLE_DEED // titre de propriété
  PROPERTY_TAX // taxe foncière
  INVOICE // facture (travaux, entretien)
  OTHER
}

// Fichier envoyé par un propriétaire, rattaché soit à un bail, soit à un bien (exactement l'un des deux)
model Document {
  id         String           @id @default(cuid())
  label      String // nom affiché (par défaut le nom du fichier)
  fileName   String // nom du fichier d'origine, pour le téléchargement
  filePath   String // chemin relatif à STORAGE_PATH
  mimeType   String
  size       Int
  category   DocumentCategory
  leaseId    String?
  lease      Lease?           @relation(fields: [leaseId], references: [id])
  propertyId String?
  property   Property?        @relation(fields: [propertyId], references: [id])
  tenantId   String?
  tenant     Tenant?          @relation(fields: [tenantId], references: [id])
  createdAt  DateTime         @default(now())

  @@index([leaseId])
  @@index([propertyId])
}

// ─────────────────────────────────────────
// ÉTAT DES LIEUX (US-22 à 25)
// ─────────────────────────────────────────

enum InventoryType {
  ENTRY
  EXIT
}

model Inventory {
  id                  String        @id @default(cuid())
  lease               Lease         @relation(fields: [leaseId], references: [id])
  leaseId             String
  type                InventoryType
  date                DateTime
  ownerSignaturePath  String?
  tenantSignaturePath String?
  pdfPath             String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  rooms InventoryRoom[]
}

model InventoryRoom {
  id          String             @id @default(cuid())
  inventory   Inventory          @relation(fields: [inventoryId], references: [id])
  inventoryId String
  name        String
  order       Int
  elements    InventoryElement[]
}

model InventoryElement {
  id        String           @id @default(cuid())
  room      InventoryRoom    @relation(fields: [roomId], references: [id])
  roomId    String
  label     String
  condition String?
  comment   String?
  photos    InventoryPhoto[]
}

model InventoryPhoto {
  id        String           @id @default(cuid())
  element   InventoryElement @relation(fields: [elementId], references: [id])
  elementId String
  filePath  String
  createdAt DateTime         @default(now())
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

// Notification d'un propriétaire (ex. révision annuelle à préparer) ; une seule par bail, sujet et échéance
model Notification {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  kind        String
  leaseId     String?
  dueDate     DateTime?
  title       String
  body        String
  link        String?
  readAt      DateTime?
  emailSentAt DateTime?
  phoneSentAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, kind, leaseId, dueDate])
  @@index([userId, createdAt])
}
