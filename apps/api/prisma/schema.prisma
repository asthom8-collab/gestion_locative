generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// UTILISATEURS
// ─────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role        @default(USER)
  // Adresse du bailleur, imprimée sur les quittances
  address      String?
  zipCode      String?
  city         String?
  // Image de la signature (PNG ou JPEG), apposée sur les quittances ; chemin relatif à STORAGE_PATH
  signaturePath      String?
  // Compte créé par un administrateur avec un mot de passe provisoire
  mustChangePassword Boolean  @default(false)
  // Incrémentée au changement de mot de passe : invalide les sessions ouvertes ailleurs
  sessionVersion     Int      @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  ownerships     Ownership[]
  createdTenants Tenant[]   @relation("TenantCreatedBy")
}

// ─────────────────────────────────────────
// BIENS IMMOBILIERS
// ─────────────────────────────────────────

enum PropertyType {
  APARTMENT
  HOUSE
  PARKING
  COMMERCIAL
}

enum FiscalRegime {
  NU
  PINEL
  LMNP_MICRO
  LMNP_REEL
}

model Property {
  id           String       @id @default(cuid())
  name         String
  address      String
  zipCode      String
  city         String
  type         PropertyType
  surface      Float
  fiscalRegime FiscalRegime
  irlQuarter   Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  ownerships   Ownership[]
  leases       Lease[]
  charges      Charge[]
  lmnpEntries  LmnpEntry[]
}

model Ownership {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  share      Float    @default(1.0)
  createdAt  DateTime @default(now())

  @@unique([propertyId, userId])
}

// ─────────────────────────────────────────
// LOCATAIRES
// ─────────────────────────────────────────

model Tenant {
  id        String     @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  iban      String?
  // Propriétaire qui a saisi le locataire : il le voit même sans bail (sinon, visibilité par les baux)
  createdBy   User?    @relation("TenantCreatedBy", fields: [createdById], references: [id])
  createdById String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  leases    Lease[]
  documents Document[]
}

// ─────────────────────────────────────────
// BAUX
// ─────────────────────────────────────────

enum LeaseType {
  UNFURNISHED
  FURNISHED
}

model Lease {
  id             String     @id @default(cuid())
  property       Property   @relation(fields: [propertyId], references: [id])
  propertyId     String
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  tenantId       String
  type           LeaseType
  startDate      DateTime
  endDate        DateTime?
  rentAmount     Float
  chargesAmount  Float
  rentDayOfMonth Int        @default(1)
  irlReference   Float?
  irlQuarter     Int?
  irlYear        Int?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  rentPayments          RentPayment[]
  chargeRegularizations ChargeRegularization[]
  documents             Document[]
  inventories           Inventory[]
}

// ─────────────────────────────────────────
// PAIEMENTS & QUITTANCES
// ─────────────────────────────────────────

enum PaymentStatus {
  PENDING
  RECEIVED
  PARTIAL
  LATE
}

enum PaymentSource {
  MANUAL
  BANK_MATCH
}

model RentPayment {
  id                String        @id @default(cuid())
  lease             Lease         @relation(fields: [leaseId], references: [id])
  leaseId           String
  periodMonth       Int
  periodYear        Int
  // Période couverte (prorata si le bail commence ou finit dans le mois)
  periodStart       DateTime
  periodEnd         DateTime
  // Montants attendus figés à la génération (loyer et charges, proratisés)
  rentAmount        Float
  chargesAmount     Float
  expectedAmount    Float
  receivedAmount    Float?
  paymentDate       DateTime?
  status            PaymentStatus @default(PENDING)
  source            PaymentSource @default(MANUAL)
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  bankTransactionId String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  receipt           Receipt?

  @@unique([leaseId, periodYear, periodMonth])
}

model Receipt {
  id            String      @id @default(cuid())
  rentPayment   RentPayment @relation(fields: [rentPaymentId], references: [id])
  rentPaymentId String      @unique
  filePath      String
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
}

// ─────────────────────────────────────────
// TRANSACTIONS BANCAIRES (Phase 3)
// ─────────────────────────────────────────

enum TransactionStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

model BankTransaction {
  id          String            @id @default(cuid())
  externalId  String            @unique
  amount      Float
  label       String
  date        DateTime
  status      TransactionStatus @default(UNMATCHED)
  createdAt   DateTime          @default(now())

  rentPayment RentPayment?
}

// ─────────────────────────────────────────
// CHARGES (Phase 4)
// ─────────────────────────────────────────

model Charge {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  year       Int
  label      String
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ChargeRegularization {
  id           String   @id @default(cuid())
  lease        Lease    @relation(fields: [leaseId], references: [id])
  leaseId      String
  year         Int
  totalCharged Float
  totalReal    Float
  balance      Float
  filePath     String?
  sentAt       DateTime?
  createdAt    DateTime @default(now())
}

// ─────────────────────────────────────────
// INDICES IRL (Phase 4)
// ─────────────────────────────────────────

model IrlIndex {
  id        String   @id @default(cuid())
  quarter   Int
  year      Int
  value     Float
  createdAt DateTime @default(now())

  @@unique([quarter, year])
}

// ─────────────────────────────────────────
// COMPTABILITÉ LMNP (Phase 5)
// ─────────────────────────────────────────

enum LmnpEntryType {
  DEPRECIATION
  LOAN_INTEREST
  INSURANCE
  MANAGEMENT_FEES
  LAND_TAX
  MAINTENANCE
  OTHER
}

model LmnpEntry {
  id         String        @id @default(cuid())
  property   Property      @relation(fields: [propertyId], references: [id])
  propertyId String
  year       Int
  type       LmnpEntryType
  label      String
  amount     Float
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

// ─────────────────────────────────────────
// DOCUMENTS (US-04)
// ─────────────────────────────────────────

enum DocumentCategory {
  LEASE_DOCUMENT
  TENANT_DOCUMENT
}

model Document {
  id        String           @id @default(cuid())
  label     String
  filePath  String
  category  DocumentCategory
  leaseId   String?
  lease     Lease?           @relation(fields: [leaseId], references: [id])
  tenantId  String?
  tenant    Tenant?          @relation(fields: [tenantId], references: [id])
  createdAt DateTime         @default(now())
}

// ─────────────────────────────────────────
// ÉTAT DES LIEUX (US-22 à 25)
// ─────────────────────────────────────────

enum InventoryType {
  ENTRY
  EXIT
}

model Inventory {
  id                  String        @id @default(cuid())
  lease               Lease         @relation(fields: [leaseId], references: [id])
  leaseId             String
  type                InventoryType
  date                DateTime
  ownerSignaturePath  String?
  tenantSignaturePath String?
  pdfPath             String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  rooms               InventoryRoom[]
}

model InventoryRoom {
  id          String             @id @default(cuid())
  inventory   Inventory          @relation(fields: [inventoryId], references: [id])
  inventoryId String
  name        String
  order       Int
  elements    InventoryElement[]
}

model InventoryElement {
  id        String          @id @default(cuid())
  room      InventoryRoom   @relation(fields: [roomId], references: [id])
  roomId    String
  label     String
  condition String?
  comment   String?
  photos    InventoryPhoto[]
}

model InventoryPhoto {
  id        String           @id @default(cuid())
  element   InventoryElement @relation(fields: [elementId], references: [id])
  elementId String
  filePath  String
  createdAt DateTime         @default(now())
}
